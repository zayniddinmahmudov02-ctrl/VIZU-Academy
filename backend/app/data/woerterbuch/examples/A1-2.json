"das Café": {"de": "Wir treffen uns im Café.", "uz": "Biz kafeda uchrashamiz."},
"das Hotelzimmer": {"de": "Das Hotelzimmer ist sauber.", "uz": "Mehmonxona xonasi toza."},
"der Reisepass": {"de": "Ich brauche einen neuen Reisepass.", "uz": "Menga yangi pasport kerak."},
"packen": {"de": "Ich packe meinen Koffer.", "uz": "Men chamadonimga narsalarimni joylayapman."},
"ankommen": {"de": "Wann kommt der Zug an?", "uz": "Poyezd qachon yetib keladi?"},
"danach": {"de": "Wir essen und danach gehen wir ins Kino.", "uz": "Biz ovqatlanamiz, keyin kinoga boramiz."},
"durstig": {"de": "Ich bin durstig.", "uz": "Men chanqadim."},
"aussteigen": {"de": "Wir steigen an der nächsten Haltestelle aus.", "uz": "Biz keyingi bekatda tushamiz."},
"endlich": {"de": "Endlich ist der Sommer da!", "uz": "Nihoyat yoz keldi!"},
"einsteigen": {"de": "Bitte steigen Sie schnell ein.", "uz": "Iltimos, tezroq chiqing."},
"satt": {"de": "Danke, ich bin satt.", "uz": "Rahmat, men to‘qman."},
"der Schlüssel": {"de": "Der Schlüssel liegt auf dem Tisch.", "uz": "Kalit stol ustida."},
"abschließen": {"de": "Vergiss nicht, die Tür abzuschließen.", "uz": "Eshikni qulflashni unutma."},
"praktisch": {"de": "Die Tasche ist sehr praktisch.", "uz": "Bu sumka juda qulay."},
"mitnehmen": {"de": "Ich nehme einen Regenschirm mit.", "uz": "Men o‘zim bilan soyabon olaman."},
"natürlich": {"de": "Natürlich helfe ich dir.", "uz": "Albatta, senga yordam beraman."},
"trocken": {"de": "Die Wäsche ist schon trocken.", "uz": "Kir allaqachon quridi."},
"zumachen": {"de": "Mach bitte das Fenster zu.", "uz": "Iltimos, derazani yop."},
"böse": {"de": "Bist du böse auf mich?", "uz": "Mendan jahling chiqdimi?"},
"trotzdem": {"de": "Es regnet, trotzdem gehen wir spazieren.", "uz": "Yomg‘ir yog‘yapti, shunga qaramay biz sayrga chiqamiz."},
"gehören": {"de": "Das Buch gehört mir.", "uz": "Bu kitob menga tegishli."},
"der Fernsehabend": {"de": "Am Freitag machen wir einen Fernsehabend.", "uz": "Juma kuni biz uyda televizor tomosha qilish kechasini o‘tkazamiz."},
"die Geburtstagsparty": {"de": "Kommst du zu meiner Geburtstagsparty?", "uz": "Mening tug‘ilgan kun bazmimga kelasanmi?"},
"das Lieblingslied": {"de": "Das ist mein Lieblingslied.", "uz": "Bu mening sevimli qo‘shig‘im."},
"der Sportplatz": {"de": "Nach der Schule gehen wir auf den Sportplatz.", "uz": "Maktabdan keyin biz sport maydoniga boramiz."},
"die Musikgruppe": {"de": "Die Musikgruppe spielt heute im Park.", "uz": "Musiqa guruhi bugun parkda chiqish qiladi."},
"das Schwimmbad": {"de": "Im Sommer gehen wir oft ins Schwimmbad.", "uz": "Yozda biz tez-tez basseynga boramiz."},
"der Stadtpark": {"de": "Der Stadtpark ist sehr grün.", "uz": "Shahar bog‘i juda yashil."},
"das Mittagessen": {"de": "Das Mittagessen ist um ein Uhr.", "uz": "Tushlik soat birda."},
"der Wochenmarkt": {"de": "Auf dem Wochenmarkt kaufe ich Obst.", "uz": "Haftalik bozordan men meva sotib olaman."},
"gratulieren": {"de": "Ich gratuliere dir zum Geburtstag!", "uz": "Seni tug‘ilgan kuning bilan tabriklayman!"},
"beliebt": {"de": "Dieses Café ist sehr beliebt.", "uz": "Bu kafe juda mashhur."},
"telefonieren": {"de": "Ich telefoniere jeden Tag mit meiner Mutter.", "uz": "Men har kuni onam bilan telefonda gaplashaman."},
"plötzlich": {"de": "Plötzlich fängt es an zu regnen.", "uz": "To‘satdan yomg‘ir yog‘a boshlaydi."},
"rauchen": {"de": "Hier darf man nicht rauchen.", "uz": "Bu yerda chekish mumkin emas."},
"hilfsbereit": {"de": "Unsere Nachbarin ist sehr hilfsbereit.", "uz": "Qo‘shni ayolimiz doim yordam berishga tayyor."},
"besonders": {"de": "Ich mag besonders den Sommer.", "uz": "Menga ayniqsa yoz yoqadi."},
"stoppen": {"de": "Der Polizist stoppt das Auto.", "uz": "Politsiyachi mashinani to‘xtatadi."},
"wirklich": {"de": "Das ist wirklich schön.", "uz": "Bu haqiqatan ham chiroyli."},
"der Terminplan": {"de": "Mein Terminplan für die Woche ist voll.", "uz": "Haftalik reja jadvalim to‘la."},
"die Frühstückspause": {"de": "In der Frühstückspause esse ich ein Brot.", "uz": "Nonushta tanaffusida men bitta buterbrod yeyman."},
"das Lieblingsessen": {"de": "Plov ist mein Lieblingsessen.", "uz": "Palov — mening sevimli ovqatim."},
"der Sprachkurs": {"de": "Der Sprachkurs beginnt im September.", "uz": "Til kursi sentabrda boshlanadi."},
"die Hausaufgabe": {"de": "Ich mache jetzt meine Hausaufgabe.", "uz": "Men hozir uy vazifamni bajaryapman."}
}
