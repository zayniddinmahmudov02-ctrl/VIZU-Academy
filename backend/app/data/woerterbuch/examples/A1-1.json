"das Tier": {"de": "Der Hund ist mein Lieblingstier.", "uz": "It mening eng sevimli hayvonim."},
"fliegen": {"de": "Wir fliegen morgen nach Berlin.", "uz": "Ertaga biz Berlinga uchamiz."},
"gefährlich": {"de": "Die Straße ist gefährlich.", "uz": "Bu ko‘cha xavfli."},
"drüben": {"de": "Die Apotheke ist dort drüben.", "uz": "Dorixona ana u narigi tomonda."},
"beginnen": {"de": "Der Unterricht beginnt um neun.", "uz": "Dars soat to‘qqizda boshlanadi."},
"bald": {"de": "Wir sehen uns bald.", "uz": "Tez orada ko‘rishamiz."},
"der Löwe": {"de": "Der Löwe ist im Zoo.", "uz": "Sher hayvonot bog‘ida."},
"die Maus": {"de": "Die Katze fängt eine Maus.", "uz": "Mushuk sichqon tutyapti."},
"das Schaf": {"de": "Das Schaf ist weiß.", "uz": "Qo‘y oq rangda."},
"der Käse": {"de": "Ich esse gern Käse.", "uz": "Men pishloq yeyishni yaxshi ko‘raman."},
"die Butter": {"de": "Die Butter ist im Kühlschrank.", "uz": "Sariyog‘ muzlatgichda."},
"das Salz": {"de": "Die Suppe braucht noch Salz.", "uz": "Sho‘rvaga yana tuz kerak."},
"der Zucker": {"de": "Ich trinke Tee ohne Zucker.", "uz": "Men choyni shakarsiz ichaman."},
"die Erdbeere": {"de": "Die Erdbeere ist rot und süß.", "uz": "Qulupnay qizil va shirin."},
"das Huhn": {"de": "Das Huhn läuft im Garten.", "uz": "Tovuq bog‘da yuribdi."},
"der Reis": {"de": "Wir kochen Reis mit Gemüse.", "uz": "Biz sabzavotli guruch pishiramiz."},
"süß": {"de": "Der Kuchen ist sehr süß.", "uz": "Tort juda shirin."},
"sauer": {"de": "Die Zitrone ist sauer.", "uz": "Limon nordon."},
"hungrig": {"de": "Ich bin sehr hungrig.", "uz": "Men juda ochman."},
"die Kartoffel": {"de": "Die Kartoffel ist noch hart.", "uz": "Kartoshka hali qattiq."},
"das Öl": {"de": "Für den Salat brauche ich Öl.", "uz": "Salat uchun menga yog‘ kerak."},
"der Bäcker": {"de": "Der Bäcker backt frisches Brot.", "uz": "Nonvoy yangi non yopadi."},
"die Verkäuferin": {"de": "Die Verkäuferin hilft mir.", "uz": "Sotuvchi ayol menga yordam beryapti."},
"das Regal": {"de": "Die Bücher stehen im Regal.", "uz": "Kitoblar javonda turibdi."},
"der Kunde": {"de": "Der Kunde möchte bezahlen.", "uz": "Mijoz to‘lamoqchi."},
"die Rechnung": {"de": "Die Rechnung, bitte!", "uz": "Hisobni bering, iltimos!"},
"das Büro": {"de": "Mein Büro ist im dritten Stock.", "uz": "Mening ofisim uchinchi qavatda."},
"der Kalender": {"de": "Der Termin steht im Kalender.", "uz": "Uchrashuv kalendarda yozilgan."},
"die Email": {"de": "Ich schicke dir eine Email.", "uz": "Men senga elektron xat yuboraman."},
"billig": {"de": "Das T-Shirt ist billig.", "uz": "Futbolka arzon."}
}
