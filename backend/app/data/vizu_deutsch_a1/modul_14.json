    {
     "title": "Futur I — Kelasi zamon",
     "html": "<p><strong>Futur I (kelasi zamon)</strong> — kelajakda bo'ladigan ish-harakatni bildiradi.</p><ul><li><strong>werden</strong> 2-o'rinda turadi.</li><li>Asosiy fe'l oxirida turadi.</li><li>Infinitiv shakli o'zgarmaydi (lernen, gehen, machen).</li></ul><table><thead><tr><th>Shaxs</th><th>werden</th><th>Misol</th><th>Tarjima</th></tr></thead><tbody><tr><td>ich</td><td>werde</td><td>Ich werde morgen lernen.</td><td>Men ertaga o'qiyman.</td></tr><tr><td>du</td><td>wirst</td><td>Du wirst Deutsch sprechen.</td><td>Sen nemis tilida gapirasan.</td></tr><tr><td>er / sie / es</td><td>wird</td><td>Er wird nach Berlin fahren.</td><td>U Berlinga boradi.</td></tr><tr><td>wir</td><td>werden</td><td>Wir werden zu Hause bleiben.</td><td>Biz uyda qolamiz.</td></tr><tr><td>ihr</td><td>werdet</td><td>Ihr werdet morgen abfahren.</td><td>Sizlar ertaga jo'nab ketasizlar.</td></tr><tr><td>sie / Sie</td><td>werden</td><td>Sie werden später kommen.</td><td>Ular keyinroq kelishadi.</td></tr></tbody></table>"
    }
   ],
