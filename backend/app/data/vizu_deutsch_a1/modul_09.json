   "content_id": "vizu-a1-l09-schreiben-01",
   "level": "A1",
   "module": 1,
   "lesson": 9,
   "skill": "schreiben",
   "title": "Schreiben: Brief — Meine Reise",
   "source": "book",
   "metadata": {
    "book_page": 95
   },
   "prompt": "Schreiben Sie einen Brief an Alex / Alexandra über Ihre Reise. Nutzen Sie die Stichwörter:\n1. Wann und wohin? Mit wem? (Letzten Sommer habe ich eine Reise gemacht. Ich bin mit meinen Freunden gereist.)\n2. Wohin? (Ich bin nach Berlin gefahren. Ich war in der Stadt …)\n3. Wo haben Sie gewohnt? (in + Dativ)\n4. Was haben Sie gemacht? (mit Ortsangaben)\n5. Essen und Trinken\n6. Wetter und Atmosphäre\n7. Besondere Erlebnisse\n8. Fazit (Meine Reise war sehr schön …)\nAnrede: Liebe/r Alex/Alexandra, … Gruß: Liebe Grüße / Mit freundlichen Grüßen, (Name)",
   "task_type": "letter",
   "audience": "Alex / Alexandra (Freund / Freundin)",
   "min_words": 60,
   "max_words": 150,
   "time_limit": 25,
   "support_phrases": [
    "Liebe/r …,",
    "Ich bin nach … gefahren.",
    "Ich habe in einem … gewohnt.",
    "Am Abend bin ich am Meer spazieren gegangen.",
    "Liebe Grüße"
   ]
