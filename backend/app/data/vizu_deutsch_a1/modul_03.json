   "rules": [
    {
     "title": "Haben und sein",
     "html": "<h3>HABEN — ega bo'lmoq</h3><table><thead><tr><th>Shaxs</th><th>haben</th><th>Misol</th></tr></thead><tbody><tr><td>ich</td><td>habe</td><td>Ich habe ein Buch. — Menda kitob bor.</td></tr><tr><td>du</td><td>hast</td><td>Du hast Zeit. — Senda vaqt bor.</td></tr><tr><td>er / sie / es</td><td>hat</td><td>Er hat einen Bruder. — Uning akasi bor.</td></tr><tr><td>wir</td><td>haben</td><td>Wir haben eine Schule. — Bizning maktabimiz bor.</td></tr><tr><td>ihr</td><td>habt</td><td>Ihr habt viele Freunde. — Sizlarning do'stlaringiz bor.</td></tr><tr><td>sie / Sie</td><td>haben</td><td>Sie haben eine Frage. — Ularda / Sizda savol bor.</td></tr></tbody></table><h3>SEIN — bo'lmoq</h3><table><thead><tr><th>Shaxs</th><th>sein</th><th>Misol</th></tr></thead><tbody><tr><td>ich</td><td>bin</td><td>Ich bin Lehrer. — Men o'qituvchiman.</td></tr><tr><td>du</td><td>bist</td><td>Du bist müde. — Sen charchagansan.</td></tr><tr><td>er / sie / es</td><td>ist</td><td>Sie ist Studentin. — U talaba (qiz).</td></tr><tr><td>wir</td><td>sind</td><td>Wir sind zu Hause. — Biz uydamiz.</td></tr><tr><td>ihr</td><td>seid</td><td>Ihr seid pünktlich. — Sizlar vaqtida keldingiz.</td></tr><tr><td>sie / Sie</td><td>sind</td><td>Sie sind freundlich. — Siz muloyimsiz.</td></tr></tbody></table>"
    },
    {
     "title": "Bestimmte und unbestimmte Artikel",
     "html": "<table><thead><tr><th>Geschlecht / Kasus</th><th>Aniq artikel (der / die / das / die)</th><th>Noaniq artikel (ein / eine)</th></tr></thead><tbody><tr><td><strong>Maskulin</strong> — Nominativ</td><td>Der Lehrer liest ein Buch.</td><td>Ein Lehrer liest ein Buch.</td></tr><tr><td>Maskulin — Genitiv</td><td>Des Lehrers Buch ist interessant.</td><td>—</td></tr><tr><td>Maskulin — Dativ</td><td>Ich gebe dem Lehrer ein Buch.</td><td>Ich gebe einem Lehrer ein Buch.</td></tr><tr><td>Maskulin — Akkusativ</td><td>Ich sehe den Lehrer.</td><td>Ich sehe einen Lehrer.</td></tr><tr><td><strong>Feminin</strong> — Nominativ</td><td>Die Lehrerin liest ein Buch.</td><td>Eine Lehrerin liest ein Buch.</td></tr><tr><td>Feminin — Genitiv</td><td>Der Lehrerin Buch ist interessant.</td><td>—</td></tr><tr><td>Feminin — Dativ</td><td>Ich gebe der Lehrerin ein Buch.</td><td>Ich gebe einer Lehrerin ein Buch.</td></tr><tr><td>Feminin — Akkusativ</td><td>Ich sehe die Lehrerin.</td><td>Ich sehe eine Lehrerin.</td></tr><tr><td><strong>Neutrum</strong> — Nominativ</td><td>Das Buch ist interessant.</td><td>Ein Buch ist interessant.</td></tr><tr><td>Neutrum — Genitiv</td><td>Des Buches Inhalt ist wichtig.</td><td>—</td></tr><tr><td>Neutrum — Dativ</td><td>Ich gebe dem Buch Aufmerksamkeit.</td><td>Ich gebe einem Buch Aufmerksamkeit.</td></tr><tr><td>Neutrum — Akkusativ</td><td>Ich lese das Buch.</td><td>Ich lese ein Buch.</td></tr><tr><td><strong>Plural</strong> — Nominativ</td><td>Die Lehrer lesen Bücher.</td><td>—</td></tr><tr><td>Plural — Genitiv</td><td>Der Lehrer Bücher sind wichtig.</td><td>—</td></tr><tr><td>Plural — Dativ</td><td>Ich gebe den Lehrern Bücher.</td><td>—</td></tr><tr><td>Plural — Akkusativ</td><td>Ich sehe die Lehrer.</td><td>—</td></tr></tbody></table>"
    }
