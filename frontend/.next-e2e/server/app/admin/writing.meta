{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/admin/layout,_N_T_/admin/writing/layout,_N_T_/admin/writing/page,_N_T_/admin/writing"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/admin/writing/__PAGE__",
    "/admin/writing",
    "/admin",
    "/_index",
    "/_head"
  ]
}