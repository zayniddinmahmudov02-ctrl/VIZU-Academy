# Copy to .env.local for local dev overrides, or set these in your
# deployment platform's environment settings for production. Never commit
# a real .env.local/.env.production file — only this example is tracked.

# Base URL the browser uses to reach the FastAPI backend. Falls back to
# http://127.0.0.1:8000 in code if unset, which only works for local dev.
# In production this MUST be set to the real backend's public URL, e.g.
# https://api.vizu.academy — otherwise every API call from the browser
# (including the entire admin panel) silently fails.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
