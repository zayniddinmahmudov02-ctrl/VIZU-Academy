# Copy to .env.local for local dev overrides, or set these in your
# deployment platform's environment settings for production. Never commit
# a real .env.local/.env.production file — only this example is tracked.

# Base URL the browser uses to reach the FastAPI backend. REQUIRED — there
# is no fallback; the app throws a build-time error if this is unset. The
# value below (http://127.0.0.1:8000) is for local dev only. In production
# this MUST be set to the real backend's public URL, e.g.
# https://api.vizu.academy — otherwise the build itself fails.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
